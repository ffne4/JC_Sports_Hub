rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - readable by everyone, writable only by the owner so
    // users can upload/update their own avatar.
    match /profile_pictures/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else the app stores must be readable/writable by the owner
    // or an admin.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}