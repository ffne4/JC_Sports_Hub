rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && request.resource.data.isAdmin == false && request.resource.data.isVerified == false;
      // Owner manages their own profile AND wallet figure (bets deduct the
      // balance, a withdrawal request moves it to pendingWithdrawal, balance
      // updates on a bet win), so those fields update in-app for the owner.
      allow update: if (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'momoNumber', 'profileImage', 'avatar', 'walletBalance', 'pendingWithdrawal']))
        // Admin also moves these figures when confirming/rejecting a deposit
        // or withdrawal request.
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance', 'pendingWithdrawal']));
    }
    match /otps/{id} {
      // OTP codes are random 6-digit codes that expire in 10 minutes and are
      // emailed to the user's own address. They must be storable and readable
      // both right after signup (user IS signed in) and in the unauthenticated
      // forgot-password flow on the login screen, so they are open. The codes
      // can't be used to do anything beyond verifying an email the user has.
      allow read, write: if true;
    }
    match /transactions/{id} {
      // A signed-in user can list/read their own transactions, and a user can
      // CREATE their own pending deposit or withdrawal request. Only an admin
      // may finalise (confirm/reject/delete) a transaction.
      allow read: if owner(resource.data.userId) || admin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['deposit', 'withdrawal']
        && request.resource.data.status == 'pending';
      allow update, delete: if admin();
    }
    match /bets/{id} { allow read: if owner(resource.data.userId) || admin(); allow write: if false; }
    match /matches/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.isAnnouncement == false;
      allow update, delete: if admin();
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if admin() || owner(resource.data.userId);
    }
    match /notifications/{id} { allow read, update: if owner(resource.data.userId); }
    match /suggestions/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read, update: if admin(); }
    match /teams/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType != 'guest';
      allow update, delete: if admin();
    }
    match /tournaments/{id} {
      allow read: if signedIn();
      allow write: if admin();
      match /squads/{squadId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType != 'guest'
          && request.resource.data.studentId == request.auth.uid;
        allow update, delete: if admin();
      }
      match /{document=**} { allow read: if signedIn(); allow write: if admin(); }
    }
  }
}
